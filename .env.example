# Copia este archivo a .env y ajusta los valores. .env NO se sube al repositorio.

# --- Base de datos (PostgreSQL en Docker) ---
DB_USER=viltrum
DB_PASSWORD=cambia_esta_contraseña
DB_NAME=viltrumflow

# --- Seguridad ---
# Genera una clave: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Producción ---
# URL pública (sin barra final), p. ej. https://tareas.midominio.com
PUBLIC_URL=http://localhost
HTTP_PORT=80

# --- Google: Calendar e inicio de sesión (opcional) ---
# Crea un cliente OAuth «Aplicación web» en https://console.cloud.google.com/apis/credentials
# URIs de redirección autorizadas (las dos):
#   desarrollo:  http://localhost:8000/api/v1/calendar/callback
#                http://localhost:8000/api/v1/auth/google/callback
#   producción:  ${PUBLIC_URL}/api/v1/calendar/callback
#                ${PUBLIC_URL}/api/v1/auth/google/callback
# GOOGLE_LOGIN_ENABLED=false oculta «Continuar con Google» y deja solo Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (opcional): recordatorios y resumen diario ---
# Sin SMTP_HOST los avisos funcionan solo en el navegador.
# Gmail: smtp.gmail.com, puerto 587 y una «contraseña de aplicación» (no la de tu cuenta).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Colección TCG: reconocer cartas con la cámara (opcional) ---
# Clave de la API de Claude (https://console.anthropic.com/settings/keys). Sin ella, la colección
# funciona igual pero las cartas se añaden a mano.
ANTHROPIC_API_KEY=
TCG_VISION_MODEL=claude-opus-5-5

# --- Avisos push (opcional) ---
# Identificación ante los servicios de push. Por defecto, PUBLIC_URL si es https
VAPID_SUBJECT=

# --- Copias de seguridad (producción) ---
# Carpeta del servidor donde se guardan y días que se conservan
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# --- Inicio de sesión ---
# Intentos fallidos permitidos por IP y cuenta cada LOGIN_WINDOW_MINUTES
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
